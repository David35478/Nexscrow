# Google OAuth (optional): create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and register
# <your-domain>/api/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: NEAR AI work engine key (falls back to the demo template without it)
NEAR_AI_API_KEY=

# Optional: 1Click (NEAR Intents) partner key for real deposits
INTENTS_API_KEY=

# Optional: storage override (defaults to ./data, falls back to /tmp)
NEXSCROW_DATA_DIR=
