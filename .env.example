# Google OAuth (optional): create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and register
# <your-domain>/api/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: NEAR AI work engine key (falls back to the demo template without it)
NEAR_AI_API_KEY=

# Escrow payouts/refunds: an ed25519 access key for the escrow account,
# e.g. "ed25519:<base58>". Without it the platform locks deposits but refuses
# payouts rather than faking transfers. Testnet key only.
ESCROW_PRIVATE_KEY=

# ---- NEAR network (see docs/testnet.md) -------------------------------------
# Development: defaults to testnet (config.yaml near.network); no value needed.
# Production (APP_ENV=production): on-chain escrow stays DISABLED until this is
# set. Only "testnet" is accepted; "mainnet" is refused by src/network.py.
# NEAR_NETWORK=testnet
# Escrow account that receives deposits and signs payouts (.testnet account).
NEXSCROW_ESCROW_ACCOUNT=
# Default agent payout account when an agent profile has none (.testnet).
NEXSCROW_AGENT_PAYOUT_ACCOUNT=
# Optional RPC override; must be https://rpc.testnet.near.org.
# NEAR_RPC_URL=https://rpc.testnet.near.org
# Development-only NEAR Intents 1Click mock (1Click has no testnet).
# NEXSCROW_INTENTS_MOCK=1

# Optional: NEAR Intents Agent API key (live agent policy reads)
NEAR_INTENTS_AGENT_API_KEY=

# Optional: durable storage (Postgres) for serverless deployments
DATABASE_URL=

# Optional: storage override for the local JSON store (defaults to ./data,
# falls back to /tmp)
NEXSCROW_DATA_DIR=

# Server-side external providers (disabled by default in config.yaml)
# WIRO_API_KEY=
# WIRO_API_SECRET=
# CUSTOM_AGENT_API_KEY=

# Subscription/top-up billing ONLY. Never use the escrow account implicitly.
# Enable billing.enabled only after settlement/accounting deployment tests pass.
# ONECLICK_API_KEY=
# BILLING_TREASURY_ADDRESS=
# BILLING_SETTLEMENT_ASSET=

# Explicit verified auth identities allowed into /admin, comma-separated.
# Demo identities are always rejected, even when present in this allowlist.
# NEXSCROW_ADMIN_USER_IDS=near:your-admin-account.near

# Production HTTP security. APP_ORIGIN is the exact public HTTPS origin.
# APP_ENV=production
# APP_ORIGIN=https://your-reviewed-domain.example
# TEST_DATABASE_URL=  # isolated test database ONLY; never a production database

# Privy login: public app ID is read at runtime (no frontend build-time secret).
# NEXT_PUBLIC_PRIVY_APP_ID is also accepted as an app ID alias.
PRIVY_APP_ID=
# Keep the app secret server-side only. JWT verification uses public JWKS, not this secret.
PRIVY_APP_SECRET=

# Admin portal email login (/admin/login). Generate the hash with: python -m src.admin_auth
# NEXSCROW_ADMIN_EMAIL=
# NEXSCROW_ADMIN_PASSWORD_HASH=
