# Network: base-sepolia (dev) or base-mainnet (live demo)
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org

# DEV ONLY: throwaway test key for Base Sepolia (fund from a faucet).
# NEVER put a mainnet key here. For mainnet use CdpEvmWalletProvider with
# CDP_API_KEY_ID / CDP_API_KEY_SECRET / CDP_WALLET_SECRET from Coinbase CDP.
# Store the real value in Vault and inject it as an environment variable.
PRIVATE_KEY=

# Sweep policy
SWEEP_THRESHOLD_USDC=10
TARGET_TICKER=AAPL
MAX_SLIPPAGE_BPS=100

# x402 research service
RESEARCH_PRICE_USD=$0.02
SERVICE_PORT=4021
FACILITATOR_URL=https://x402.org/facilitator

# Vercel deployment
# Where x402 payments land (defaults to the PRIVATE_KEY wallet if unset)
PAY_TO_ADDRESS=0xDBd1d65442eebb3CA888510941dcc72E5867C63B
# Secret Vercel Cron sends as Bearer token to protect /api/sweep
CRON_SECRET=

# Public Coinbase Tokenized Stocks API (keyless)
STOCKS_API_URL=https://api.coinbase.com/v1/tokenized-stocks
